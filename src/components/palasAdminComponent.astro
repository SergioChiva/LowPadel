<style>
    :root {
        --color-principal: #00c896;
        --color-acento: #9333ea;
        --primary-light: #6ee7b7;
        --color-acento-light: #c084fc;
    }

    .admin-palas {
        display: none;
        max-width: 1400px;
        margin: 0 auto 60px;
        padding: 0 20px;
        animation: fadeIn 0.5s ease-in-out;
    }

    .admin-palas.visible {
        display: block;
    }

    .admin-palas-card {
        background: linear-gradient(135deg, rgba(0, 200, 150, 0.1), rgba(147, 51, 234, 0.1));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 2px solid rgba(0, 200, 150, 0.3);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 200, 150, 0.2);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .admin-palas-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 80px rgba(0, 200, 150, 0.3);
    }

    .admin-palas-card h2 {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #00c896, #9333ea);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 30px;
        text-align: center;
        font-weight: 700;
    }

    .admin-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .btn-admin {
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        color: #1a2332;
        border: none;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 8px 20px rgba(0, 200, 150, 0.3);
    }

    .btn-admin.eliminar {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }

    .btn-admin:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 12px 30px rgba(0, 200, 150, 0.4);
    }

    .btn-admin.eliminar:hover {
        box-shadow: 0 12px 30px rgba(239, 68, 68, 0.4);
    }

    .panel-form {
        display: none;
        margin-top: 30px;
        animation: slideDown 0.4s ease-out;
    }

    .panel-form.visible {
        display: block;
    }

    .admin-form {
        background: rgba(26, 35, 50, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 200, 150, 0.2);
        border-radius: 20px;
        padding: 35px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    label {
        color: #6ee7b7;
        font-size: 1.1rem;
        font-weight: 600;
    }

    input[type="text"],
    input[type="file"],
    textarea,
    select {
        background: rgba(26, 35, 50, 0.8);
        border: 2px solid rgba(0, 200, 150, 0.3);
        border-radius: 12px;
        padding: 14px 18px;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    input[type="text"]:focus,
    textarea:focus,
    select:focus {
        outline: none;
        border-color: #00c896;
        box-shadow: 0 0 20px rgba(0, 200, 150, 0.3);
        transform: translateY(-2px);
    }

    textarea {
        min-height: 100px;
        resize: vertical;
    }

    input[type="file"] {
        cursor: pointer;
        padding: 12px;
    }

    input[type="file"]::file-selector-button {
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        color: #1a2332;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        margin-right: 15px;
        transition: all 0.3s ease;
    }

    input[type="file"]::file-selector-button:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(0, 200, 150, 0.4);
    }

    .preview-container {
        display: none;
        text-align: center;
        margin-top: 15px;
    }

    .preview-container.visible {
        display: block;
        animation: fadeIn 0.3s ease-in-out;
    }

    .preview-image {
        max-width: 200px;
        max-height: 200px;
        border-radius: 16px;
        border: 3px solid #00c896;
        box-shadow: 0 10px 30px rgba(0, 200, 150, 0.3);
    }

    .form-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }

    .btn-form {
        background: linear-gradient(135deg, #9333ea, #c084fc);
        color: white;
        border: none;
        padding: 14px 30px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 6px 15px rgba(147, 51, 234, 0.3);
    }

    .btn-form:hover {
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 10px 25px rgba(147, 51, 234, 0.4);
    }

    .btn-reset {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        box-shadow: 0 6px 15px rgba(239, 68, 68, 0.3);
    }

    .btn-reset:hover {
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            max-height: 0;
        }
        to {
            opacity: 1;
            max-height: 2000px;
        }
    }

    @keyframes slideIn {
        from {
            transform: translateX(400px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @keyframes slideOut {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(400px);
            opacity: 0;
        }
    }

    /* Notificaciones del carrito */
    .notificacion-carrito {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        transform: translateX(400px);
        transition: transform 0.3s ease;
        min-width: 300px;
    }

    .notificacion-carrito.show {
        transform: translateX(0);
    }

    .notificacion-carrito.notif-success {
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        box-shadow: 0 8px 25px rgba(0, 200, 150, 0.4);
    }

    .notificacion-carrito.notif-error {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    .notif-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .notif-mensaje {
        flex: 1;
    }

    .notif-close {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 18px;
        line-height: 1;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .notif-close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.1);
    }

    @media (max-width: 768px) {
        .admin-palas-card {
            padding: 25px;
        }

        .admin-palas-card h2 {
            font-size: 2rem;
        }

        .admin-buttons {
            flex-direction: column;
        }

        .form-buttons {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-palas">
