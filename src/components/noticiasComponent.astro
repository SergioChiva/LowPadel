<!-- 
    🎯 SISTEMA DE ADMINISTRACIÓN DE NOTICIAS
    
    📋 INSTRUCCIONES PARA USAR EL PANEL ADMIN:
    
    1. REGISTRARSE COMO ADMIN:
       - Ve a la página de registro (/register)
       - Usa un email que contenga la palabra "admin" (ejemplo: admin@lowpadel.com)
       - El sistema detectará automáticamente que eres administrador
    
    2. ACCEDER AL PANEL:
       - Una vez registrado como admin, ve a la sección de Noticias
       - Verás el Panel de Administración en la parte superior
    
    3. AGREGAR/EDITAR NOTICIAS:
       - Haz clic en "➕ Agregar/Editar Noticia"
       - Rellena: Título, Imagen, Fecha y Contenido
       - Selecciona qué noticia quieres sobrescribir (1, 2 o 3)
       - Las imágenes se guardan en Base64 para persistencia
    
    4. ELIMINAR NOTICIAS:
       - Haz clic en "🗑️ Eliminar Noticia"
       - Selecciona la noticia a eliminar del desplegable
       - Confirma la eliminación
    
    5. PERSISTENCIA:
       - Todas las noticias se guardan en localStorage
       - Los cambios persisten entre sesiones
       - Las imágenes se convierten a Base64 automáticamente
    
    ✨ CARACTERÍSTICAS:
    - Diseño moderno con glassmorphism y gradientes verde/púrpura
    - Vista previa de imágenes antes de guardar
    - Validación de campos obligatorios
    - Mensajes de confirmación para todas las acciones
    - Responsive y optimizado para móviles
-->

<style>
    .noticias-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    /* Panel de Administración */
    .admin {
        display: none;
        margin-bottom: 60px;
        animation: fadeIn 0.5s ease-in-out;
    }

    .admin.visible {
        display: block;
    }

    .admin-card {
        background: linear-gradient(135deg, rgba(0, 200, 150, 0.1), rgba(147, 51, 234, 0.1));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 2px solid rgba(0, 200, 150, 0.3);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 200, 150, 0.2);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .admin-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 80px rgba(0, 200, 150, 0.3);
    }

    .admin-card h2 {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #00c896, #9333ea);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 30px;
        text-align: center;
        font-weight: 700;
    }

    .admin-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .btn-agregar, .btn-eliminar {
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        color: #1a2332;
        border: none;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 8px 20px rgba(0, 200, 150, 0.3);
        position: relative;
        overflow: hidden;
    }

    .btn-eliminar {
        background: linear-gradient(135deg, #9333ea, #c084fc);
        color: white;
        box-shadow: 0 8px 20px rgba(147, 51, 234, 0.3);
    }

    .btn-agregar:hover, .btn-eliminar:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 12px 30px rgba(0, 200, 150, 0.4);
    }

    .btn-eliminar:hover {
        box-shadow: 0 12px 30px rgba(147, 51, 234, 0.4);
    }

    .btn-agregar:active, .btn-eliminar:active {
        transform: translateY(-1px) scale(1.02);
    }

    /* Formularios */
    .agregar, .eliminar {
        display: none;
        margin-top: 30px;
        animation: slideDown 0.4s ease-out;
    }

    .agregar.visible, .eliminar.visible {
        display: block;
    }

    form {
        background: rgba(26, 35, 50, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 200, 150, 0.2);
        border-radius: 20px;
        padding: 35px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    label {
        color: #6ee7b7;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: -10px;
    }

    input[type="text"],
    input[type="date"],
    input[type="file"],
    textarea,
    select {
        background: rgba(26, 35, 50, 0.8);
        border: 2px solid rgba(0, 200, 150, 0.3);
        border-radius: 12px;
        padding: 14px 18px;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    input[type="text"]:focus,
    input[type="date"]:focus,
    textarea:focus,
    select:focus {
        outline: none;
        border-color: #00c896;
        box-shadow: 0 0 20px rgba(0, 200, 150, 0.3);
        transform: translateY(-2px);
    }

    textarea {
        min-height: 120px;
        resize: vertical;
    }

    input[type="file"] {
        cursor: pointer;
        padding: 12px;
    }

    input[type="file"]::file-selector-button {
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        color: #1a2332;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        margin-right: 15px;
        transition: all 0.3s ease;
    }

    input[type="file"]::file-selector-button:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(0, 200, 150, 0.4);
    }

    .form-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }

    input[type="button"],
    input[type="reset"] {
        background: linear-gradient(135deg, #9333ea, #c084fc);
        color: white;
        border: none;
        padding: 14px 30px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 6px 15px rgba(147, 51, 234, 0.3);
    }

    input[type="button"]:hover,
    input[type="reset"]:hover {
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 10px 25px rgba(147, 51, 234, 0.4);
    }

    input[type="reset"] {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        box-shadow: 0 6px 15px rgba(239, 68, 68, 0.3);
    }

    input[type="reset"]:hover {
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4);
    }

    /* Vista previa de imagen */
    .preview-container {
        display: none;
        margin-top: 15px;
        text-align: center;
    }

    .preview-container.visible {
        display: block;
        animation: fadeIn 0.3s ease-in-out;
    }

    .preview-image {
        max-width: 100%;
        max-height: 300px;
        border-radius: 16px;
        border: 3px solid #00c896;
        box-shadow: 0 10px 30px rgba(0, 200, 150, 0.3);
    }

    /* Separador */
    hr {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, #00c896, #9333ea, transparent);
        margin: 60px 0;
        opacity: 0.5;
    }

    /* Tarjetas de Noticias */
    .noticias-card {
        background: linear-gradient(135deg, rgba(26, 35, 50, 0.8), rgba(0, 200, 150, 0.05));
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 2px solid rgba(0, 200, 150, 0.2);
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 40px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .noticias-card:hover {
        transform: translateY(-10px);
        border-color: #00c896;
        box-shadow: 0 25px 60px rgba(0, 200, 150, 0.3);
    }

    .noticia-titulo {
        font-size: 2.2rem;
        background: linear-gradient(135deg, #00c896, #6ee7b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 25px;
        font-weight: 700;
        line-height: 1.3;
    }

    .noticia-imagen {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-radius: 20px;
        margin-bottom: 25px;
        border: 3px solid rgba(0, 200, 150, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        transition: all 0.3s ease;
    }

    .noticia-imagen:hover {
        transform: scale(1.02);
        border-color: #00c896;
        box-shadow: 0 15px 40px rgba(0, 200, 150, 0.4);
    }

    .noticia-fecha {
        color: #9333ea;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .noticia-contenido {
        color: #e5e7eb;
        font-size: 1.15rem;
        line-height: 1.8;
        text-align: justify;
    }

    /* Animaciones */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            max-height: 0;
        }
        to {
            opacity: 1;
            max-height: 1000px;
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .admin-card {
            padding: 25px;
        }

        .admin-card h2 {
            font-size: 2rem;
        }

        .admin-buttons {
            flex-direction: column;
        }

        .noticia-titulo {
            font-size: 1.8rem;
        }

        .noticia-imagen {
            height: 250px;
        }

        .form-buttons {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="noticias-container">
    
    <div class="admin">
        <div class="admin-card">
            <h2>🛡️ Panel de Administración</h2>
            <div class="admin-buttons">
                <button class="btn-agregar">➕ Agregar/Editar Noticia</button>
                <button class="btn-eliminar">🗑️ Eliminar Noticia</button>
            </div>
            
            <div class="agregar">
                <form id="formNoticia">
                    <label for="nombreNoticia">📰 Título de noticia:</label>
                    <input type="text" name="nombreNoticia" id="nombreNoticia" placeholder="Introduce el título de la noticia..." required>

                    <label for="imagenNoticia">🖼️ Inserta Imagen de la noticia:</label>
                    <input type="file" id="imagenNoticia" name="imagenNoticia" accept="image/*">
                    
                    <div class="preview-container" id="previewContainer">
                        <img id="previewImage" class="preview-image" alt="Vista previa">
                    </div>
                    
                    <label for="fechaNoticia">📅 Fecha de la noticia:</label>
                    <input type="date" name="fechaNoticia" id="fechaNoticia" required>

                    <label for="contenidoNoticia">📝 Contenido de la noticia:</label>
                    <textarea name="contenidoNoticia" id="contenidoNoticia" rows="6" placeholder="Escribe el contenido completo de la noticia..." required></textarea>

                    <div class="form-buttons">
                        <input type="button" class="btn-sobrescribir" data-index="0" value="💾 Sobrescribir Noticia 1">
                        <input type="button" class="btn-sobrescribir" data-index="1" value="💾 Sobrescribir Noticia 2">
                        <input type="button" class="btn-sobrescribir" data-index="2" value="💾 Sobrescribir Noticia 3">
                        <input type="reset" value="🔄 Resetear Formulario">
                    </div>
                </form>
            </div>

            <div class="eliminar">
                <form id="formEliminar">
                    <label for="eliminarNoticia">🗑️ Selecciona la noticia a eliminar:</label>
                    <select name="eliminarNoticia" id="eliminarNoticia">
                        <option value="0">Noticia 1</option>
                        <option value="1">Noticia 2</option>
                        <option value="2">Noticia 3</option>
                    </select>
                    <div class="form-buttons">
                        <input type="button" id="btnEliminarNoticia" value="❌ Eliminar Noticia Seleccionada">
                    </div>
                </form>
            </div>

        </div>
    </div>

    <hr>

    <div class="noticias-card n1">
        <h2 class="noticia-titulo"></h2>
        <img src="" alt="" class="noticia-imagen"/>
        <p class="noticia-fecha"></p>
        <p class="noticia-contenido"></p>  
    </div>

    <div class="noticias-card n2">
        <h2 class="noticia-titulo"></h2>
        <img src="" alt="" class="noticia-imagen"/>
        <p class="noticia-fecha"></p>
        <p class="noticia-contenido"></p>  
    </div>

    <div class="noticias-card n3">
        <h2 class="noticia-titulo"></h2>
        <img src="" alt="" class="noticia-imagen"/>
        <p class="noticia-fecha"></p>
        <p class="noticia-contenido"></p>  
    </div>

</section>

<script>
    // Definir tipo para las noticias
    type Noticia = {
        titulo: string;
        imagen: string;
        fecha: string;
        contenido: string;
    };

    // Obtener o inicializar noticias desde localStorage
    const noticiasGuardadas = localStorage.getItem('noticias');
    let noticias: Noticia[] = noticiasGuardadas ? JSON.parse(noticiasGuardadas) : [
        {
            titulo: "🎾 Nuevo Torneo de Pádel en Madrid",
            imagen: "https://images.unsplash.com/photo-1554068865-24cecd4e34b8?w=800",
            fecha: "2024-07-15",
            contenido: "Se anuncia un nuevo torneo de pádel que se llevará a cabo en Madrid con la participación de los mejores jugadores del mundo. Este evento promete ser uno de los más importantes de la temporada."
        },
        {
            titulo: "🏆 Lanzamiento de Nueva Pala de Pádel",
            imagen: "https://images.unsplash.com/photo-1622163642998-1ea32b0bbc67?w=800",
            fecha: "2024-06-30",
            contenido: "Una reconocida marca de equipamiento deportivo ha lanzado una nueva pala de pádel que promete mejorar el rendimiento en la pista. Incorpora tecnología de última generación y materiales innovadores."
        },
        {
            titulo: "🌟 Entrevista Exclusiva con el Campeón del Mundo",
            imagen: "https://images.unsplash.com/photo-1526232761682-d26e03ac148e?w=800",
            fecha: "2024-06-20",
            contenido: "Hemos tenido la oportunidad de entrevistar al actual campeón del mundo de pádel, quien comparte sus secretos para el éxito, su rutina de entrenamiento y sus planes para la próxima temporada."
        }
    ];

    // Guardar noticias en localStorage
    function guardarNoticias() {
        localStorage.setItem('noticias', JSON.stringify(noticias));
    }

    // Función para cargar las noticias en el DOM
    function cargarNoticias() {
        noticias.forEach((noticia, index) => {
            const claseNoticia = `.n${index + 1}`;
            const cardNoticia = document.querySelector(claseNoticia);
            
            if (cardNoticia) {
                const titulo = cardNoticia.querySelector('.noticia-titulo');
                const imagen = cardNoticia.querySelector('.noticia-imagen') as HTMLImageElement;
                const fecha = cardNoticia.querySelector('.noticia-fecha');
                const contenido = cardNoticia.querySelector('.noticia-contenido');
                
                if (titulo) titulo.textContent = noticia.titulo || 'Sin título';
                if (imagen) {
                    imagen.src = noticia.imagen || 'https://via.placeholder.com/800x400?text=Sin+Imagen';
                    imagen.alt = noticia.titulo || 'Noticia';
                }
                if (fecha) fecha.textContent = `📅 ${noticia.fecha || 'Fecha no disponible'}`;
                if (contenido) contenido.textContent = noticia.contenido || 'Sin contenido';
                
                // Mostrar u ocultar tarjeta según si existe contenido
                if (noticia.titulo) {
                    (cardNoticia as HTMLElement).style.display = 'block';
                } else {
                    (cardNoticia as HTMLElement).style.display = 'none';
                }
            }
        });
    }

    // Verificar si el usuario es admin
    function verificarAdmin() {
        const usuario = JSON.parse(localStorage.getItem('usuario') || '{}');
        const adminPanel = document.querySelector('.admin');
        
        // Verificar credenciales específicas de admin
        if (usuario.admin === true) {
            adminPanel?.classList.add('visible');
        }
    }

    // Variables para la imagen temporal
    let imagenTemporal = '';

    // Manejo del input de imagen con vista previa
    const inputImagen = document.getElementById('imagenNoticia') as HTMLInputElement;
    const previewContainer = document.getElementById('previewContainer');
    const previewImage = document.getElementById('previewImage') as HTMLImageElement;

    if (inputImagen) {
        inputImagen.addEventListener('change', (e) => {
            const archivo = (e.target as HTMLInputElement).files?.[0];
            if (archivo) {
                const reader = new FileReader();
                reader.onload = () => {
                    imagenTemporal = reader.result as string;
                    if (previewImage && previewContainer) {
                        previewImage.src = imagenTemporal;
                        previewContainer.classList.add('visible');
                    }
                };
                reader.readAsDataURL(archivo);
            }
        });
    }

    // Botones de agregar y eliminar
    const btnAgregar = document.querySelector('.btn-agregar');
    const btnEliminar = document.querySelector('.btn-eliminar');
    const divAgregar = document.querySelector('.agregar');
    const divEliminar = document.querySelector('.eliminar');

    if (btnAgregar) {
        btnAgregar.addEventListener('click', () => {
            divAgregar?.classList.toggle('visible');
            divEliminar?.classList.remove('visible');
        });
    }

    if (btnEliminar) {
        btnEliminar.addEventListener('click', () => {
            divEliminar?.classList.toggle('visible');
            divAgregar?.classList.remove('visible');
        });
    }

    // Botones de sobrescribir
    const botonesSobrescribir = document.querySelectorAll('.btn-sobrescribir');
    botonesSobrescribir.forEach((boton) => {
        boton.addEventListener('click', (e) => {
            const index = parseInt((e.target as HTMLElement).dataset.index || '0');
            const titulo = (document.getElementById('nombreNoticia') as HTMLInputElement).value;
            const fecha = (document.getElementById('fechaNoticia') as HTMLInputElement).value;
            const contenido = (document.getElementById('contenidoNoticia') as HTMLTextAreaElement).value;

            if (!titulo || !fecha || !contenido) {
                alert('⚠️ Por favor, completa todos los campos obligatorios');
                return;
            }

            // Actualizar la noticia
            noticias[index] = {
                titulo,
                imagen: imagenTemporal || noticias[index].imagen || 'https://via.placeholder.com/800x400?text=Sin+Imagen',
                fecha,
                contenido
            };

            guardarNoticias();
            cargarNoticias();

            // Limpiar formulario
            (document.getElementById('formNoticia') as HTMLFormElement)?.reset();
            imagenTemporal = '';
            previewContainer?.classList.remove('visible');

            alert(`✅ Noticia ${index + 1} actualizada correctamente`);
        });
    });

    // Botón de eliminar noticia
    const btnEliminarNoticia = document.getElementById('btnEliminarNoticia');
    if (btnEliminarNoticia) {
        btnEliminarNoticia.addEventListener('click', () => {
            const select = document.getElementById('eliminarNoticia') as HTMLSelectElement;
            const index = parseInt(select.value);

            if (confirm(`❓ ¿Estás seguro de que quieres eliminar la Noticia ${index + 1}?`)) {
                // Reemplazar con noticia vacía
                noticias[index] = {
                    titulo: '',
                    imagen: '',
                    fecha: '',
                    contenido: ''
                };

                guardarNoticias();
                cargarNoticias();

                alert(`✅ Noticia ${index + 1} eliminada correctamente`);
            }
        });
    }

    // Resetear también la vista previa
    const formNoticia = document.getElementById('formNoticia');
    if (formNoticia) {
        formNoticia.addEventListener('reset', () => {
            imagenTemporal = '';
            previewContainer?.classList.remove('visible');
        });
    }

    // Cargar todo cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
        cargarNoticias();
        verificarAdmin();
    });
</script>