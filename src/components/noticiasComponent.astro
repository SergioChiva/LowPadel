---
// Componente de noticias - muestra las 3 noticias principales de la base de datos
---

<link rel="stylesheet" href="/styles/noticias.css">

<div class="noticias-container">
    <h1 class="noticias-titulo-principal">Últimas Noticias</h1>
    <p class="noticias-subtitle">Mantente al día con las novedades del mundo del pádel</p>
    
    <div id="noticiasGrid" class="noticias-grid">
        <div class="loading">Cargando noticias...</div>
    </div>
</div>

<script is:inline>
    async function cargarNoticias() {
        const grid = document.getElementById('noticiasGrid');
        
        try {
            const res = await fetch('/api/noticias?limit=3');
            const data = await res.json();
            
            if (data.success && data.noticias && data.noticias.length > 0) {
                grid.innerHTML = data.noticias.map(noticia => {
                    const fecha = new Date(noticia.fechaPublicacion).toLocaleDateString('es-ES', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric'
                    });
                    
                    return `
                        <div class="noticia-card">
                            <img src="${noticia.imagen}" alt="${noticia.titulo}" class="noticia-imagen" />
                            <div class="noticia-contenido">
                                <h2 class="noticia-titulo">${noticia.titulo}</h2>
                                <p class="noticia-resumen">${noticia.resumen || noticia.contenido.substring(0, 150) + '...'}</p>
                                <div class="noticia-meta">
                                    <span class="noticia-fecha">
                                        📅 ${fecha}
                                    </span>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            } else {
                grid.innerHTML = '<div class="sin-noticias">📰 No hay noticias disponibles en este momento</div>';
            }
        } catch (error) {
            console.error('Error al cargar noticias:', error);
            grid.innerHTML = '<div class="sin-noticias">❌ Error al cargar las noticias. Por favor, intenta más tarde.</div>';
        }
    }
    
    // Cargar noticias al cargar la página
    cargarNoticias();
</script>
