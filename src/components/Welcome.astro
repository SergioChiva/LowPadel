<script src="../../public/scripts/jugadores.js"></script>
<style>
.galeria {
  width: 100%;
  position: relative;
}

.fondoRed {
  position: fixed; /* para que esté siempre de fondo */
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh; /* altura de la ventana */
  object-fit: cover; /* ajusta la imagen sin deformarla */
  z-index: -1; /* para que quede detrás de todo */
}


.grid {
  position: absolute;
  top: 5%;
  left: 0;
  width: 100%;
  height: 50%;
  
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 columnas iguales */
  align-items: center;
  text-align: center;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rem; /* espacio entre nombre e imagen */
}

.nombre {
  font-size: 50px;
  font-weight: bold;
  color: white;
  text-shadow: 2px 2px 4px black;
  margin: 0;
}

.jugador {
  position: relative;
  height: 450px; /* ajusta al gusto */
  width: auto;
  cursor: pointer;
}

.jugador img {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 100%;
  transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out;
}

.jugador1 {
  opacity: 1;
  z-index: 1;
}

.jugador2 {
  opacity: 0;
  z-index: 2;
  transform: translateX(-50%) scale(1.1);
}

.jugador:hover .jugador1 {
  opacity: 0;
  transform: translateX(-50%) scale(0.95);
}

.jugador:hover .jugador2 {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}
</style>
