---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="checkout-container">
    <h1>🛒 Finalizar Compra</h1>

    <div class="checkout-grid">
      <!-- Resumen del Pedido -->
      <div class="order-summary">
        <h2>Resumen del Pedido</h2>
        <div id="productosResumen"></div>
        
        <div class="totals">
          <div class="total-line">
            <span>Subtotal:</span>
            <span id="subtotal">0€</span>
          </div>
          <div class="total-line">
            <span>Envío:</span>
            <span id="envio">5€</span>
          </div>
          <div class="total-line total-final">
            <span>Total:</span>
            <span id="total">0€</span>
          </div>
        </div>
      </div>

      <!-- Formulario de Pago -->
      <div class="payment-form-container">
        <form id="checkoutForm">
          <h2>Datos de Envío</h2>
          
          <div class="form-group">
            <label for="nombre">Nombre completo *</label>
            <input type="text" id="nombre" required>
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" required>
          </div>

          <div class="form-group">
            <label for="telefono">Teléfono *</label>
            <input type="tel" id="telefono" required placeholder="+34 600 000 000">
          </div>

          <div class="form-group">
            <label for="direccion">Dirección *</label>
            <input type="text" id="direccion" required placeholder="Calle, número, piso">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="ciudad">Ciudad *</label>
              <input type="text" id="ciudad" required>
            </div>

            <div class="form-group">
              <label for="codigoPostal">Código Postal *</label>
              <input type="text" id="codigoPostal" required pattern="[0-9]{5}" placeholder="28001">
            </div>
          </div>

          <div class="form-group">
            <label for="pais">País</label>
            <select id="pais">
              <option value="España">España</option>
              <option value="Portugal">Portugal</option>
              <option value="Francia">Francia</option>
            </select>
          </div>

          <h2 style="margin-top: 2rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle;">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            Datos de Pago
          </h2>
          <p class="payment-info">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle;">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Pago simulado - No se realizará ningún cargo real
          </p>

          <!-- Tarjeta Visual -->
          <div class="credit-card">
            <div class="card-chip"></div>
            <div class="card-number" id="cardNumberDisplay">•••• •••• •••• ••••</div>
            <div class="card-details">
              <div class="card-holder">
                <span class="label">TITULAR</span>
                <div id="cardHolderDisplay">TU NOMBRE</div>
              </div>
              <div class="card-expiry">
                <span class="label">VÁLIDO HASTA</span>
                <div id="cardExpiryDisplay">MM/AA</div>
              </div>
              <div class="card-logo">💳</div>
            </div>
          </div>

          <div class="form-group">
            <label for="numeroTarjeta">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
              Número de Tarjeta *
            </label>
            <input type="text" id="numeroTarjeta" required placeholder="1234 5678 9012 3456" maxlength="19">
            <div id="cardError" class="error-message"></div>
          </div>

          <div class="form-group">
            <label for="nombreTitular">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              Nombre del Titular *
            </label>
            <input type="text" id="nombreTitular" required placeholder="COMO APARECE EN LA TARJETA">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="fechaExpiracion">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Fecha de Expiración *
              </label>
              <input type="text" id="fechaExpiracion" required placeholder="MM/AA" maxlength="5">
            </div>

            <div class="form-group">
              <label for="cvv">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                CVV *
              </label>
              <input type="text" id="cvv" required placeholder="123" maxlength="3">
            </div>
          </div>

          <button type="submit" class="btn-pay">
            <span>🔒 Pagar Ahora</span>
          </button>

          <p class="security-info">
            🛡️ Conexión segura SSL - Tus datos están protegidos
          </p>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal de Confirmación -->
  <div id="modalConfirmacion" class="modal hidden">
    <div class="modal-content">
      <div class="success-animation">
        <div class="checkmark">✓</div>
      </div>
      <h2>¡Compra Realizada!</h2>
      <p>Tu pedido ha sido procesado exitosamente.</p>
      <p class="order-number">Número de pedido: <strong id="numeroPedido"></strong></p>
      <p>Recibirás un email de confirmación en breve.</p>
      <button id="btnVerPedidos" class="btn-primary">Ver Mis Pedidos</button>
      <button id="btnSeguirComprando" class="btn-secondary">Seguir Comprando</button>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Verificar si hay carrito
    const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
    
    if (carrito.length === 0) {
      alert('Tu carrito está vacío');
      window.location.href = '/palas';
      return;
    }

    // Verificar si hay usuario logueado
    const usuarioStorage = localStorage.getItem('usuario');
    if (!usuarioStorage) {
      alert('Debes iniciar sesión para continuar');
      localStorage.setItem('redirectAfterLogin', '/checkout');
      window.location.href = '/login';
      return;
    }

    const usuario = JSON.parse(usuarioStorage);

    // Prellenar datos del usuario
    document.getElementById('nombre').value = usuario.nombre || '';
    document.getElementById('email').value = usuario.email || '';

    // Mostrar resumen del pedido
    mostrarResumen(carrito);

    // Formatear número de tarjeta
    const numeroTarjetaInput = document.getElementById('numeroTarjeta');
    const cardNumberDisplay = document.getElementById('cardNumberDisplay');
    
    numeroTarjetaInput.addEventListener('input', (e) => {
      let value = e.target.value.replace(/\s/g, '');
      let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
      e.target.value = formattedValue;
      
      // Actualizar tarjeta visual
      if (value.length > 0) {
        cardNumberDisplay.textContent = formattedValue.padEnd(19, '•');
      } else {
        cardNumberDisplay.textContent = '•••• •••• •••• ••••';
      }
      
      // Validar número de tarjeta (algoritmo de Luhn simplificado)
      validarTarjeta(value);
    });

    // Actualizar nombre del titular en tarjeta visual
    document.getElementById('nombreTitular').addEventListener('input', (e) => {
      const cardHolderDisplay = document.getElementById('cardHolderDisplay');
      cardHolderDisplay.textContent = e.target.value.toUpperCase() || 'TU NOMBRE';
    });

    // Formatear fecha de expiración
    const fechaExpiracionInput = document.getElementById('fechaExpiracion');
    const cardExpiryDisplay = document.getElementById('cardExpiryDisplay');
    
    fechaExpiracionInput.addEventListener('input', (e) => {
      let value = e.target.value.replace(/\D/g, '');
      if (value.length >= 2) {
        value = value.slice(0, 2) + '/' + value.slice(2, 4);
      }
      e.target.value = value;
      
      // Actualizar tarjeta visual
      cardExpiryDisplay.textContent = value || 'MM/AA';
    });

    // Solo números en CVV
    document.getElementById('cvv').addEventListener('input', (e) => {
      e.target.value = e.target.value.replace(/\D/g, '');
    });

    // Solo números en código postal
    document.getElementById('codigoPostal').addEventListener('input', (e) => {
      e.target.value = e.target.value.replace(/\D/g, '');
    });

    // Enviar formulario
    document.getElementById('checkoutForm').addEventListener('submit', (e) => {
      e.preventDefault();
      procesarPago(carrito, usuario);
    });

    // Botones del modal
    document.getElementById('btnVerPedidos').addEventListener('click', () => {
      window.location.href = '/perfil';
    });

    document.getElementById('btnSeguirComprando').addEventListener('click', () => {
      window.location.href = '/palas';
    });
  });

  function validarTarjeta(numero) {
    const errorDiv = document.getElementById('cardError');
    
    // Limpiar espacios
    numero = numero.replace(/\s/g, '');
    
    // Debe tener 16 dígitos
    if (numero.length === 0) {
      errorDiv.textContent = '';
      return false;
    }
    
    if (numero.length < 16) {
      errorDiv.textContent = 'El número debe tener 16 dígitos';
      return false;
    }
    
    // Algoritmo de Luhn (validación básica)
    let suma = 0;
    let esSegundoDigito = false;
    
    for (let i = numero.length - 1; i >= 0; i--) {
      let digito = parseInt(numero[i]);
      
      if (esSegundoDigito) {
        digito *= 2;
        if (digito > 9) digito -= 9;
      }
      
      suma += digito;
      esSegundoDigito = !esSegundoDigito;
    }
    
    if (suma % 10 !== 0) {
      errorDiv.textContent = '⚠️ Número de tarjeta inválido';
      return false;
    }
    
    errorDiv.textContent = '✅ Número válido';
    errorDiv.style.color = '#4caf50';
    return true;
  }

  function mostrarResumen(carrito) {
    const container = document.getElementById('productosResumen');
    let subtotal = 0;

    container.innerHTML = carrito.map(item => {
      const precio = parseFloat(item.precio);
      const cantidad = item.cantidad || 1;
      const totalItem = precio * cantidad;
      subtotal += totalItem;

      return `
        <div class="producto-resumen">
          <img src="${item.imagen}" alt="${item.nombre}">
          <div class="producto-info">
            <h3>${item.nombre}</h3>
            <p>${item.jugador}</p>
            <p class="cantidad">Cantidad: ${cantidad}</p>
          </div>
          <div class="producto-precio">
            ${totalItem.toFixed(2)}€
          </div>
        </div>
      `;
    }).join('');

    const envio = 5;
    const total = subtotal + envio;

    document.getElementById('subtotal').textContent = subtotal.toFixed(2) + '€';
    document.getElementById('total').textContent = total.toFixed(2) + '€';
  }

  function procesarPago(carrito, usuario) {
    // Simular procesamiento
    const btnSubmit = document.querySelector('.btn-pay');
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<span>Procesando...</span>';

    setTimeout(() => {
      // Crear pedido
      const pedido = {
        id: Date.now(),
        usuario: usuario.email,
        productos: carrito.map(item => ({
          nombre: item.nombre,
          jugador: item.jugador,
          precio: parseFloat(item.precio),
          cantidad: item.cantidad || 1
        })),
        total: carrito.reduce((sum, item) => sum + (parseFloat(item.precio) * (item.cantidad || 1)), 0) + 5,
        estado: 'pendiente',
        fecha: new Date().toISOString(),
        direccion: {
          calle: document.getElementById('direccion').value,
          ciudad: document.getElementById('ciudad').value,
          codigoPostal: document.getElementById('codigoPostal').value,
          pais: document.getElementById('pais').value
        },
        datosPago: {
          numeroTarjeta: '**** **** **** ' + document.getElementById('numeroTarjeta').value.slice(-4),
          nombreTitular: document.getElementById('nombreTitular').value,
          fechaExpiracion: document.getElementById('fechaExpiracion').value
        }
      };

      // Guardar pedido
      const pedidos = JSON.parse(localStorage.getItem('pedidos') || '[]');
      pedidos.push(pedido);
      localStorage.setItem('pedidos', JSON.stringify(pedidos));

      // Añadir pedido al usuario
      usuario.pedidos = usuario.pedidos || [];
      usuario.pedidos.push(pedido);
      localStorage.setItem('usuario', JSON.stringify(usuario));

      // Limpiar carrito
      localStorage.removeItem('carrito');

      // Mostrar modal de confirmación
      document.getElementById('numeroPedido').textContent = '#' + pedido.id;
      document.getElementById('modalConfirmacion').classList.remove('hidden');
    }, 2000);
  }
</script>

<style>
  .checkout-container {
    max-width: 1400px;
    margin: 2rem auto;
    padding: 2rem;
  }

  h1 {
    text-align: center;
    color: var(--primary);
    font-size: 2.2rem;
    margin-bottom: 2.5rem;
    text-shadow: 0 2px 10px rgba(0, 200, 150, 0.3);
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: 450px 1fr;
    gap: 2.5rem;
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 968px) {
    .checkout-grid {
      grid-template-columns: 1fr;
    }
  }

  .order-summary, .payment-form-container {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  h2 {
    color: var(--primary);
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .producto-resumen {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    background: linear-gradient(135deg, rgba(0, 200, 150, 0.08), rgba(147, 51, 234, 0.03));
    border: 1px solid rgba(0, 200, 150, 0.15);
    border-radius: 12px;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }

  .producto-resumen:hover {
    background: linear-gradient(135deg, rgba(0, 200, 150, 0.12), rgba(147, 51, 234, 0.05));
    border-color: rgba(0, 200, 150, 0.3);
  }

  .producto-resumen img {
    width: 70px;
    height: 70px;
    object-fit: contain;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    border-radius: 10px;
    padding: 8px;
    border: 1px solid rgba(0, 200, 150, 0.2);
  }

  .producto-info {
    flex: 1;
    min-width: 0;
  }

  .producto-info h3 {
    color: var(--text-light);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.3rem 0;
  }

  .producto-info p {
    color: var(--primary);
    font-size: 0.85rem;
    margin: 0.2rem 0;
    opacity: 0.9;
  }

  .producto-info .cantidad {
    color: var(--text-light);
    opacity: 0.7;
    font-size: 0.8rem;
  }

  .producto-precio {
    color: var(--primary);
    font-size: 1.3rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .totals {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 2px solid rgba(0, 200, 150, 0.3);
  }

  .total-line {
    display: flex;
    justify-content: space-between;
    color: var(--text-light);
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
  }

  .total-final {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary);
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid rgba(0, 200, 150, 0.3);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: var(--text-light);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .form-group input, .form-group select {
    width: 100%;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: var(--text-light);
    font-size: 1rem;
  }

  .form-group input:focus, .form-group select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 200, 150, 0.3);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .payment-info {
    background: rgba(33, 150, 243, 0.1);
    border: 1px solid rgba(33, 150, 243, 0.3);
    padding: 0.8rem;
    border-radius: 8px;
    color: #64b5f6;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  /* Tarjeta de Crédito Visual */
  .credit-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 15px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
    position: relative;
    overflow: hidden;
    min-height: 200px;
  }

  .credit-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  .card-chip {
    width: 50px;
    height: 40px;
    background: linear-gradient(135deg, #ffd700, #ffed4e);
    border-radius: 8px;
    margin-bottom: 2rem;
    position: relative;
  }

  .card-chip::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 5px;
    right: 5px;
    bottom: 5px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .card-number {
    font-size: 1.5rem;
    letter-spacing: 3px;
    color: white;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .card-details {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    color: white;
    position: relative;
    z-index: 1;
  }

  .card-details .label {
    font-size: 0.7rem;
    opacity: 0.8;
    display: block;
    margin-bottom: 0.3rem;
  }

  .card-holder, .card-expiry {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .card-logo {
    font-size: 2rem;
    align-self: end;
  }

  /* Error Messages */
  .error-message {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    color: #f44336;
    min-height: 20px;
  }

  .form-group label svg {
    vertical-align: middle;
    margin-right: 0.3rem;
  }

    border-radius: 10px;
    padding: 1rem;
    color: var(--primary-light);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .btn-pay {
    width: 100%;
    padding: 1.2rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    border: none;
    border-radius: 15px;
    color: white;
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
    box-shadow: 0 6px 20px rgba(0, 200, 150, 0.4);
  }

  .btn-pay:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 200, 150, 0.5);
  }

  .btn-pay:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .security-info {
    text-align: center;
    color: rgba(241, 245, 249, 0.6);
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  /* Modal */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
  }

  .modal.hidden {
    display: none;
  }

  .modal-content {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.1));
    backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 200, 150, 0.3);
    border-radius: 30px;
    padding: 3rem;
    text-align: center;
    max-width: 500px;
    box-shadow: 0 20px 60px rgba(0, 200, 150, 0.4);
  }

  .success-animation {
    margin-bottom: 2rem;
  }

  .checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    font-size: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    animation: scaleIn 0.5s ease-out;
    box-shadow: 0 0 30px rgba(0, 200, 150, 0.6);
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .modal-content h2 {
    color: var(--primary);
    margin-bottom: 1rem;
    font-size: 2rem;
