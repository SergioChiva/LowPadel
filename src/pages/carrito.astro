---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="carrito-container">
    <h1>🛒 Mi Carrito</h1>

    <div id="carritoVacio" class="carrito-vacio" style="display: none;">
      <div class="empty-icon">🛒</div>
      <h2>Tu carrito está vacío</h2>
      <p>¡Añade productos para comenzar tu compra!</p>
      <a href="/palas" class="btn-seguir-comprando">
        Ver Productos
      </a>
    </div>

    <div id="carritoContenido" class="carrito-content">
      <div class="productos-grid" id="productosCarrito">
        <!-- Los productos se cargarán aquí dinámicamente -->
      </div>

      <div class="carrito-resumen">
        <div class="resumen-card">
          <h2>Resumen del Pedido</h2>
          
          <div class="resumen-linea">
            <span>Subtotal</span>
            <span id="subtotal">0.00€</span>
          </div>
          
          <div class="resumen-linea">
            <span>Envío</span>
            <span id="envio">5.00€</span>
          </div>
          
          <div class="resumen-linea resumen-total">
            <span>Total</span>
            <span id="total">0.00€</span>
          </div>

          <button id="btnCheckout" class="btn-checkout">
            🔒 Proceder al Pago
          </button>

          <a href="/palas" class="btn-seguir-comprando-link">
            ← Seguir Comprando
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    cargarCarrito();
  });

  function cargarCarrito() {
    const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
    
    if (carrito.length === 0) {
      mostrarCarritoVacio();
      return;
    }

    mostrarCarritoConProductos(carrito);
    calcularTotales(carrito);
  }

  function mostrarCarritoVacio() {
    document.getElementById('carritoVacio').style.display = 'flex';
    document.getElementById('carritoContenido').style.display = 'none';
  }

  function mostrarCarritoConProductos(carrito) {
    document.getElementById('carritoVacio').style.display = 'none';
    document.getElementById('carritoContenido').style.display = 'grid';
    
    const container = document.getElementById('productosCarrito');
    container.innerHTML = carrito.map((item, index) => `
      <div class="producto-card" data-index="${index}">
        <div class="producto-imagen">
          <img src="${item.imagen}" alt="${item.nombre}" loading="lazy">
        </div>
        
        <div class="producto-detalles">
          <h3 class="producto-nombre">${item.nombre}</h3>
          <p class="producto-jugador">${item.jugador}</p>
        </div>
        
        <div class="producto-precio">
          ${parseFloat(item.precio).toFixed(2)}€
        </div>
        
        <div class="cantidad-control">
          <button class="btn-cantidad" onclick="cambiarCantidad(${index}, -1)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <span class="cantidad-numero">${item.cantidad || 1}</span>
          <button class="btn-cantidad" onclick="cambiarCantidad(${index}, 1)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>
        
        <button class="btn-eliminar" onclick="eliminarProducto(${index})" title="Eliminar producto">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <line x1="10" y1="11" x2="10" y2="17"></line>
            <line x1="14" y1="11" x2="14" y2="17"></line>
          </svg>
        </button>
      </div>
    `).join('');

    // Botón de checkout
    document.getElementById('btnCheckout').addEventListener('click', () => {
      window.location.href = '/checkout';
    });
  }

  function cambiarCantidad(index, cambio) {
    let carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
    
    if (carrito[index]) {
      carrito[index].cantidad = (carrito[index].cantidad || 1) + cambio;
      
      // Si la cantidad llega a 0, eliminar el producto
      if (carrito[index].cantidad <= 0) {
        carrito.splice(index, 1);
        mostrarNotificacion('Producto eliminado del carrito', 'info');
      } else {
        mostrarNotificacion('Cantidad actualizada', 'success');
      }
      
      localStorage.setItem('carrito', JSON.stringify(carrito));
      
      // Actualizar contador global
      if (typeof window.actualizarContadorCarrito === 'function') {
        window.actualizarContadorCarrito();
      }
      
      // Recargar vista del carrito
      cargarCarrito();
    }
  }

  function eliminarProducto(index) {
    if (confirm('¿Estás seguro de que quieres eliminar este producto?')) {
      let carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
      carrito.splice(index, 1);
      localStorage.setItem('carrito', JSON.stringify(carrito));
      
      // Actualizar contador global
      if (typeof window.actualizarContadorCarrito === 'function') {
        window.actualizarContadorCarrito();
      }
      
      mostrarNotificacion('Producto eliminado del carrito', 'info');
      cargarCarrito();
    }
  }

  function calcularTotales(carrito) {
    const subtotal = carrito.reduce((sum, item) => {
      return sum + (parseFloat(item.precio) * (item.cantidad || 1));
    }, 0);
    
    const envio = subtotal > 0 ? 5 : 0;
    const total = subtotal + envio;

    document.getElementById('subtotal').textContent = subtotal.toFixed(2) + '€';
    document.getElementById('envio').textContent = envio.toFixed(2) + '€';
    document.getElementById('total').textContent = total.toFixed(2) + '€';
  }

  function mostrarNotificacion(mensaje, tipo = 'success') {
    const notif = document.createElement('div');
    notif.className = `notificacion-carrito notif-${tipo}`;
    notif.innerHTML = `
      <div class="notif-content">
        <span class="notif-mensaje">${mensaje}</span>
        <button class="notif-close" onclick="this.parentElement.parentElement.remove()">×</button>
      </div>
    `;
    
    document.body.appendChild(notif);
    
    setTimeout(() => {
      notif.classList.add('show');
    }, 100);
    
    setTimeout(() => {
      notif.classList.remove('show');
      setTimeout(() => notif.remove(), 300);
    }, 3000);
  }
</script>

<style is:global>
  .carrito-container {
    max-width: 1400px;
    margin: 2rem auto;
    padding: 2rem;
    min-height: 70vh;
  }

  h1 {
    text-align: center;
    color: var(--primary);
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-shadow: 0 2px 10px rgba(0, 200, 150, 0.3);
  }

  /* Carrito Vacío */
  .carrito-vacio {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
  }

  .empty-icon {
    font-size: 5rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .carrito-vacio h2 {
    color: var(--text-light);
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .carrito-vacio p {
    color: rgba(241, 245, 249, 0.7);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  /* Contenido del Carrito */
  .carrito-content {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 968px) {
    .carrito-content {
      grid-template-columns: 1fr;
    }

    .carrito-resumen {
      order: 2;
    }
  }

  /* Grid de Productos */
  .productos-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Tarjeta de Producto */
  .producto-card {
    background: linear-gradient(135deg, rgba(0, 200, 150, 0.15), rgba(147, 51, 234, 0.1));
    backdrop-filter: blur(10px);
    border: 2px solid rgba(0, 200, 150, 0.3);
    border-radius: 15px;
    padding: 1rem;
    display: grid;
    grid-template-columns: 80px 1fr auto auto auto;
    gap: 1rem;
    align-items: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .producto-card:hover {
    transform: translateX(5px);
    box-shadow: 0 6px 25px rgba(0, 200, 150, 0.4);
    border-color: var(--primary);
  }

  @media (max-width: 768px) {
    .producto-card {
      grid-template-columns: 60px 1fr;
      gap: 0.8rem;
    }
    
    .cantidad-control {
      grid-column: 1 / -1;
      justify-self: center;
    }
    
    .btn-eliminar {
      grid-column: 1 / -1;
      justify-self: center;
      width: 100%;
    }
  }

  /* Imagen del Producto */
  .producto-imagen {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .producto-imagen {
      width: 60px;
      height: 60px;
    }
  }

  .producto-imagen img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
  }

  /* Detalles del Producto */
  .producto-detalles {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .producto-nombre {
    color: var(--primary);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .producto-jugador {
    color: var(--accent-light);
    font-size: 0.9rem;
    margin: 0;
  }

  .producto-precio {
    color: var(--text-light);5);
    border: 2px solid var(--primary);
    border-radius: 50px;
    padding: 0.2rem;
  }

  .btn-cantidad {
    background: var(--primary);
    border: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--primary-dark);
  }

  .btn-cantidad:hover {
    background: var(--primary-light);
    transform: scale(1.15);
  }

  .btn-cantidad:active {
    transform: scale(0.9);
  }

  .cantidad-numero {
    color: var(--text-light);
    font-size: 1.1rem;
    font-weight: 700;
    min-width: 35px;
    text-align: center;
  }

  /* Botón Eliminar */
  .btn-eliminar {
    background: rgba(239, 68, 68, 0.2);
    border: 2px solid #ef4444;
    color: #ef4444;
    padding: 0.5rem;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    width: 45px;
    height: 45px;
  }

  .btn-eliminar:hover {
    background: #ef4444;
    color: white;
    transform: scale(1.1);
  }

  .btn-eliminar:active {
    transform: scale(0.95).3s ease;
  }

  .btn-eliminar:hover {
    background: #ef4444;
    color: white;
    transform: scale(1.05);
  }

  /* Subtotal del Producto */
  .producto-subtotal {
    color: rgba(241, 245, 249, 0.8);
    font-size: 1rem;
    margin-top: auto;
  }

  .producto-subtotal strong {
    color: var(--primary);
    font-size: 1.2rem;
  }

  /* Resumen del Pedido */
  .carrito-resumen {
    position: sticky;
    top: 2rem;
  }

  .resumen-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .resumen-card h2 {
    color: var(--primary);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .resumen-linea {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    font-size: 1.1rem;
  }

  .resumen-total {
    border-bottom: none;
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  /* Botones */
  .btn-checkout {
    width: 100%;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: var(--primary-dark);
    border: none;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 1.5rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 200, 150, 0.3);
  }

  .btn-checkout:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0, 200, 150, 0.5);
  }

  .btn-checkout:active {
    transform: translateY(-1px);
  }

  .btn-seguir-comprando,
  .btn-seguir-comprando-link {
    display: block;
    text-align: center;
    color: var(--primary-light);
    text-decoration: none;
    margin-top: 1rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-seguir-comprando {
    background: rgba(147, 51, 234, 0.2);
    border: 2px solid var(--accent);
    padding: 1rem 2rem;
    border-radius: 50px;
    color: var(--accent-light);
    font-size: 1.1rem;
  }

  .btn-seguir-comprando:hover,
  .btn-seguir-comprando-link:hover {
    color: var(--primary);
    transform: translateX(5px);
  }

  /* Notificaciones */
  .notificacion-carrito {
    position: fixed;
    top: 100px;
    right: -400px;
    background: linear-gradient(135deg, rgba(0, 200, 150, 0.95), rgba(110, 231, 183, 0.95));
    backdrop-filter: blur(10px);
    padding: 1rem 1.5rem;
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition: right 0.3s ease;
    z-index: 10000;
    min-width: 300px;
    max-width: 400px;
  }

  .notificacion-carrito.show {
    right: 20px;
  }

  .notificacion-carrito.notif-info {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.95), rgba(147, 197, 253, 0.95));
  }

  .notif-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: white;
  }

  .notif-mensaje {
    font-weight: 600;
    font-size: 1rem;
  }

  .notif-close {
    background: rgba(255, 255, 255, 0.3);
    border: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.5rem;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .notif-close:hover {
    background: rgba(255, 255, 255, 0.5);
    transform: scale(1.1);
  }
</style>
