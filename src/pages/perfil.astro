---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="perfil-container">
    <div class="perfil-header-banner">
      <h1>Mi Perfil</h1>
      <button id="btnCerrarSesion" class="btn-logout">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Cerrar Sesión
      </button>
    </div>

    <!-- Card Principal del Usuario -->
    <div class="perfil-main-card">
      <div class="perfil-avatar-section">
        <div class="avatar-wrapper">
          <img id="fotoPerfil" src="https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png" alt="Foto de perfil">
          <button id="btnCambiarFoto" class="btn-edit-avatar" title="Cambiar foto">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </button>
        </div>
        <div class="perfil-user-info">
          <h2 id="nombreUsuario">Usuario</h2>
          <p id="nickUsuario" class="nick">@usuario</p>
          <p id="emailUsuario" class="email">email@ejemplo.com</p>
        </div>
      </div>
    </div>

    <!-- Navegación por Pestañas -->
    <div class="tabs-navigation">
      <button class="tab-btn active" data-tab="datos">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        Mis Datos
      </button>
      <button class="tab-btn" data-tab="seguridad">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Seguridad
      </button>
      <button class="tab-btn" data-tab="pedidos">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        Mis Pedidos
      </button>
    </div>

    <!-- Contenido de las Pestañas -->
    <div class="tabs-content">
      
      <!-- Pestaña: Mis Datos -->
      <div id="tab-datos" class="tab-panel active">
        <div class="settings-card">
          <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Información Personal
          </h3>
          <form id="formDatosPersonales">
            <div class="form-row">
              <div class="form-group">
                <label for="editNombre">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                  Nombre Completo
                </label>
                <input type="text" id="editNombre" required>
              </div>
              <div class="form-group">
                <label for="editNick">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                    <line x1="9" y1="9" x2="9.01" y2="9"></line>
                    <line x1="15" y1="9" x2="15.01" y2="9"></line>
                  </svg>
                  Nickname
                </label>
                <input type="text" id="editNick" required>
              </div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary">Guardar Cambios</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Pestaña: Seguridad -->
      <div id="tab-seguridad" class="tab-panel">
        <div class="settings-card">
          <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="20" y1="8" x2="20" y2="14"></line>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
            Cambiar Email
          </h3>
          <form id="formCambiarEmail">
            <div class="form-group">
              <label for="nuevoEmail">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Nuevo Email
              </label>
              <input type="email" id="nuevoEmail" placeholder="nuevo@email.com" required>
            </div>
            <div class="form-group">
              <label for="confirmarEmailPassword">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Confirmar con tu Contraseña Actual
              </label>
              <input type="password" id="confirmarEmailPassword" placeholder="••••••••" required>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary">Actualizar Email</button>
            </div>
          </form>
        </div>

        <div class="settings-card">
          <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Cambiar Contraseña
          </h3>
          <form id="formCambiarPassword">
            <div class="form-group">
              <label for="passwordActual">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Contraseña Actual
              </label>
              <input type="password" id="passwordActual" placeholder="••••••••" required>
            </div>
            <div class="form-group">
              <label for="passwordNueva">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Nueva Contraseña
              </label>
              <input type="password" id="passwordNueva" placeholder="••••••••" required>
              <small class="form-hint">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula, 1 número y 1 carácter especial</small>
            </div>
            <div class="form-group">
              <label for="passwordConfirmar">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Confirmar Nueva Contraseña
              </label>
              <input type="password" id="passwordConfirmar" placeholder="••••••••" required>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary">Cambiar Contraseña</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Pestaña: Mis Pedidos -->
      <div id="tab-pedidos" class="tab-panel">
        <div id="listaPedidos"></div>
      </div>
      
    </div>

    <!-- Modal Cambiar Foto -->
    <div id="modalCambiarFoto" class="modal hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Cambiar Foto de Perfil</h3>
          <button class="btn-close-modal">&times;</button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="urlNuevaFoto">URL de la Imagen</label>
            <input type="url" id="urlNuevaFoto" placeholder="https://ejemplo.com/imagen.jpg">
          </div>
          <div class="preview-foto">
            <img id="previewFoto" src="https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png" alt="Preview">
          </div>
        </div>
        <div class="modal-footer">
          <button id="btnGuardarFoto" class="btn-primary">Guardar</button>
          <button id="btnCancelarFoto" class="btn-secondary">Cancelar</button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Verificar si hay usuario logueado
    const usuarioStorage = localStorage.getItem('usuario');
    if (!usuarioStorage) {
      alert('Debes iniciar sesión');
      window.location.href = '/register';
      return;
    }

    let usuario = JSON.parse(usuarioStorage);
    
    // Mostrar información del usuario
    cargarDatosUsuario();

    // Cargar pedidos desde la API
    cargarPedidosDesdeAPI();

    // === NAVEGACIÓN POR PESTAÑAS ===
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.dataset.tab;
        
        // Remover active de todos
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        
        // Activar el seleccionado
        btn.classList.add('active');
        document.getElementById(`tab-${tabId}`).classList.add('active');
      });
    });

    // === CERRAR SESIÓN ===
    document.getElementById('btnCerrarSesion').addEventListener('click', () => {
      if (confirm('¿Estás seguro de que quieres cerrar sesión?')) {
        localStorage.removeItem('usuario');
        window.location.href = '/';
      }
    });

    // === MODAL CAMBIAR FOTO ===
    const modalFoto = document.getElementById('modalCambiarFoto');
    const btnCambiarFoto = document.getElementById('btnCambiarFoto');
    const btnCerrarModal = document.querySelector('.btn-close-modal');
    const btnCancelarFoto = document.getElementById('btnCancelarFoto');
    const btnGuardarFoto = document.getElementById('btnGuardarFoto');
    const inputUrlFoto = document.getElementById('urlNuevaFoto');
    const previewFoto = document.getElementById('previewFoto');

    btnCambiarFoto.addEventListener('click', () => {
      modalFoto.classList.remove('hidden');
      inputUrlFoto.value = usuario.imagen || '';
      previewFoto.src = usuario.imagen || 'https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png';
    });

    [btnCerrarModal, btnCancelarFoto].forEach(btn => {
      btn.addEventListener('click', () => {
        modalFoto.classList.add('hidden');
      });
    });

    inputUrlFoto.addEventListener('input', (e) => {
      const url = e.target.value;
      if (url) {
        previewFoto.src = url;
        previewFoto.onerror = () => {
          previewFoto.src = 'https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png';
        };
      }
    });

    btnGuardarFoto.addEventListener('click', () => {
      usuario.imagen = inputUrlFoto.value;
      localStorage.setItem('usuario', JSON.stringify(usuario));
      document.getElementById('fotoPerfil').src = usuario.imagen || 'https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png';
      modalFoto.classList.add('hidden');
      mostrarNotificacion('✅ Foto de perfil actualizada', 'success');
    });

    // === FORMULARIO DATOS PERSONALES ===
    document.getElementById('formDatosPersonales').addEventListener('submit', (e) => {
      e.preventDefault();
      
      usuario.nombre = document.getElementById('editNombre').value;
      usuario.nick = document.getElementById('editNick').value;
      
      localStorage.setItem('usuario', JSON.stringify(usuario));
      cargarDatosUsuario();
      mostrarNotificacion('✅ Datos personales actualizados', 'success');
    });

    // === FORMULARIO CAMBIAR EMAIL ===
    document.getElementById('formCambiarEmail').addEventListener('submit', (e) => {
      e.preventDefault();
      
      const nuevoEmail = document.getElementById('nuevoEmail').value;
      const password = document.getElementById('confirmarEmailPassword').value;

      // Validar email
      if (!nuevoEmail.includes('@') || !nuevoEmail.includes('.')) {
        mostrarNotificacion('❌ Email no válido', 'error');
        return;
      }

      // En producción, aquí verificarías la contraseña con el backend
      // Por ahora, solo actualizamos
      usuario.email = nuevoEmail;
      localStorage.setItem('usuario', JSON.stringify(usuario));
      cargarDatosUsuario();
      
      document.getElementById('formCambiarEmail').reset();
      mostrarNotificacion('✅ Email actualizado correctamente', 'success');
    });

    // === FORMULARIO CAMBIAR CONTRASEÑA ===
    document.getElementById('formCambiarPassword').addEventListener('submit', (e) => {
      e.preventDefault();
      
      const passwordActual = document.getElementById('passwordActual').value;
      const passwordNueva = document.getElementById('passwordNueva').value;
      const passwordConfirmar = document.getElementById('passwordConfirmar').value;

      // Validar que las contraseñas coincidan
      if (passwordNueva !== passwordConfirmar) {
        mostrarNotificacion('❌ Las contraseñas no coinciden', 'error');
        return;
      }

      // Validar fortaleza de la contraseña
      if (
        passwordNueva.length < 8 ||
        !/[A-Z]/.test(passwordNueva) ||
        !/[a-z]/.test(passwordNueva) ||
        !/[0-9]/.test(passwordNueva) ||
        !/[!@#$%^&*._-]/.test(passwordNueva)
      ) {
        mostrarNotificacion('❌ La contraseña no cumple los requisitos de seguridad', 'error');
        return;
      }

      // En producción, aquí verificarías la contraseña actual con el backend
      // Por ahora, solo guardamos la nueva
      usuario.password = passwordNueva;
      localStorage.setItem('usuario', JSON.stringify(usuario));
      
      document.getElementById('formCambiarPassword').reset();
      mostrarNotificacion('✅ Contraseña cambiada exitosamente', 'success');
    });

    // === FUNCIONES AUXILIARES ===
    function cargarDatosUsuario() {
      usuario = JSON.parse(localStorage.getItem('usuario'));
      
      document.getElementById('nombreUsuario').textContent = usuario.nombre || 'Usuario';
      document.getElementById('nickUsuario').textContent = '@' + (usuario.nick || 'usuario');
      document.getElementById('emailUsuario').textContent = usuario.email || 'email@ejemplo.com';
      document.getElementById('fotoPerfil').src = usuario.imagen || 'https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png';
      
      // Cargar valores en formularios
      document.getElementById('editNombre').value = usuario.nombre || '';
      document.getElementById('editNick').value = usuario.nick || '';
    }

    function mostrarNotificacion(mensaje, tipo) {
      // Crear elemento de notificación
      const notif = document.createElement('div');
      notif.className = `notificacion notif-${tipo}`;
      notif.textContent = mensaje;
      document.body.appendChild(notif);

      // Mostrar con animación
      setTimeout(() => notif.classList.add('show'), 100);

      // Ocultar y eliminar
      setTimeout(() => {
        notif.classList.remove('show');
        setTimeout(() => notif.remove(), 300);
      }, 3000);
    }
  });

  async function cargarPedidosDesdeAPI() {
    const token = localStorage.getItem('token');
    if (!token) {
      cargarPedidos([]);
      return;
    }

    try {
      const response = await fetch('/api/pedidos', {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      const data = await response.json();

      if (data.success && data.pedidos) {
        cargarPedidos(data.pedidos);
      } else {
        cargarPedidos([]);
      }
    } catch (error) {
      console.error('Error al cargar pedidos:', error);
      cargarPedidos([]);
    }
  }

  function cargarPedidos(pedidos) {
    const listaPedidos = document.getElementById('listaPedidos');
    
    if (!pedidos || pedidos.length === 0) {
      listaPedidos.innerHTML = `
        <div class="no-pedidos">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <h3>No tienes pedidos aún</h3>
          <p>Cuando realices un pedido, aparecerá aquí</p>
          <a href="/palas" class="btn-primary">Ver Productos</a>
        </div>
      `;
      return;
    }

    listaPedidos.innerHTML = pedidos.map(pedido => {
      const fecha = new Date(pedido.fecha || pedido.createdAt);
      const pedidoId = pedido._id || pedido.id;
      
      return `
      <div class="pedido-card pedido-${pedido.estado}">
        <div class="pedido-status-badge">
          <span class="estado estado-${pedido.estado}">
            ${getEstadoIcon(pedido.estado)}
            ${pedido.estado.toUpperCase()}
          </span>
        </div>
        <div class="pedido-content">
          <div class="pedido-header">
            <div class="pedido-info">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                </svg>
                Pedido #${pedidoId.slice(-8).toUpperCase()}
              </h3>
              <p class="pedido-fecha">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                ${fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              ${pedido.direccionEnvio ? `
                <p class="pedido-direccion">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  ${pedido.direccionEnvio.ciudad}, ${pedido.direccionEnvio.codigoPostal}
                </p>
              ` : ''}
            </div>
          </div>
          
          <div class="pedido-productos">
            <h4>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
              Productos (${pedido.productos.length})
            </h4>
            ${pedido.productos.map(p => `
              <div class="producto-item">
                <div class="producto-detalle">
                  <span class="producto-nombre">• ${p.nombre}</span>
                  ${p.jugador ? `<span class="producto-jugador">${p.jugador}</span>` : ''}
                  ${p.cantidad > 1 ? `<span class="producto-cantidad">x${p.cantidad}</span>` : ''}
                </div>
                <span class="precio">${(p.precio * (p.cantidad || 1)).toFixed(2)}€</span>
              </div>
            `).join('')}
          </div>
          
          <div class="pedido-footer">
            <div class="pedido-desglose">
              <div class="desglose-linea">
                <span>Subtotal:</span>
                <span>${pedido.subtotal ? pedido.subtotal.toFixed(2) : '0.00'}€</span>
              </div>
              <div class="desglose-linea">
                <span>Envío:</span>
                <span>${pedido.envio ? pedido.envio.toFixed(2) : '5.00'}€</span>
              </div>
            </div>
            <div class="pedido-total">
              <span>Total del pedido</span>
              <strong>${pedido.total.toFixed(2)}€</strong>
            </div>
          </div>
        </div>
      </div>
    `;
    }).join('');
  }
  
  function getEstadoIcon(estado) {
    const icons = {
      'pendiente': '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
      'procesando': '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path></svg>',
