---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="perfil-container">
    <h1>Mi Perfil</h1>
    
    <!-- Información del Usuario -->
    <div class="perfil-card">
      <div class="perfil-header">
        <img id="fotoPerfil" src="https://images.icon-icons.com/1378/PNG/512/avatardefault_92824.png" alt="Foto de perfil">
        <div class="perfil-info">
          <h2 id="nombreUsuario">Usuario</h2>
          <p id="emailUsuario">email@ejemplo.com</p>
        </div>
      </div>

      <button id="btnEditarPerfil" class="btn-primary">Editar Perfil</button>
    </div>

    <!-- Formulario de Edición (oculto por defecto) -->
    <div id="formEdicion" class="form-edicion hidden">
      <h3>Editar Datos</h3>
      <form id="editForm">
        <div class="form-group">
          <label for="nuevoNombre">Nombre:</label>
          <input type="text" id="nuevoNombre" required>
        </div>

        <div class="form-group">
          <label for="nuevoEmail">Email:</label>
          <input type="email" id="nuevoEmail" required>
        </div>

        <div class="form-group">
          <label for="nuevaPassword">Nueva Contraseña (opcional):</label>
          <input type="password" id="nuevaPassword" placeholder="Dejar en blanco para mantener la actual">
        </div>

        <div class="form-group">
          <label for="nuevaFoto">URL Foto de Perfil:</label>
          <input type="url" id="nuevaFoto" placeholder="https://...">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Guardar Cambios</button>
          <button type="button" id="btnCancelar" class="btn-secondary">Cancelar</button>
        </div>
      </form>
    </div>

    <!-- Historial de Pedidos -->
    <div class="pedidos-section">
      <h2>Mis Pedidos</h2>
      <div id="listaPedidos"></div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Verificar si hay usuario logueado
    const usuarioStorage = localStorage.getItem('usuario');
    if (!usuarioStorage) {
      alert('Debes iniciar sesión');
      window.location.href = '/register';
      return;
    }

    const usuario = JSON.parse(usuarioStorage);
    
    // Mostrar información del usuario
    document.getElementById('nombreUsuario').textContent = usuario.nombre;
    document.getElementById('emailUsuario').textContent = usuario.email;
    if (usuario.fotoPerfil) {
      document.getElementById('fotoPerfil').src = usuario.fotoPerfil;
    }

    // Cargar pedidos
    cargarPedidos(usuario.pedidos || []);

    // Botón editar perfil
    document.getElementById('btnEditarPerfil').addEventListener('click', () => {
      document.getElementById('formEdicion').classList.remove('hidden');
      document.getElementById('nuevoNombre').value = usuario.nombre;
      document.getElementById('nuevoEmail').value = usuario.email;
      if (usuario.fotoPerfil) {
        document.getElementById('nuevaFoto').value = usuario.fotoPerfil;
      }
    });

    // Botón cancelar
    document.getElementById('btnCancelar').addEventListener('click', () => {
      document.getElementById('formEdicion').classList.add('hidden');
    });

    // Formulario de edición
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const datos = {
        nombre: document.getElementById('nuevoNombre').value,
        email: document.getElementById('nuevoEmail').value,
        fotoPerfil: document.getElementById('nuevaFoto').value || usuario.fotoPerfil
      };

      const nuevaPassword = document.getElementById('nuevaPassword').value;
      if (nuevaPassword) {
        datos.password = nuevaPassword;
      }

      // Actualizar en localStorage (luego será con API)
      const usuarioActualizado = { ...usuario, ...datos };
      localStorage.setItem('usuario', JSON.stringify(usuarioActualizado));

      // Actualizar vista
      document.getElementById('nombreUsuario').textContent = datos.nombre;
      document.getElementById('emailUsuario').textContent = datos.email;
      if (datos.fotoPerfil) {
        document.getElementById('fotoPerfil').src = datos.fotoPerfil;
      }

      document.getElementById('formEdicion').classList.add('hidden');
      alert('✅ Perfil actualizado exitosamente');
    });
  });

  function cargarPedidos(pedidos) {
    const listaPedidos = document.getElementById('listaPedidos');
    
    if (!pedidos || pedidos.length === 0) {
      listaPedidos.innerHTML = '<p class="no-pedidos">No tienes pedidos aún</p>';
      return;
    }

    listaPedidos.innerHTML = pedidos.map(pedido => `
      <div class="pedido-card">
        <div class="pedido-header">
          <h3>Pedido #${pedido.id}</h3>
          <span class="estado estado-${pedido.estado}">${pedido.estado}</span>
        </div>
        <p class="pedido-fecha">${new Date(pedido.fecha).toLocaleDateString()}</p>
        <div class="pedido-productos">
          ${pedido.productos.map(p => `<p>• ${p.nombre} - ${p.precio}€</p>`).join('')}
        </div>
        <p class="pedido-total"><strong>Total: ${pedido.total}€</strong></p>
      </div>
    `).join('');
  }
</script>

<style>
  .perfil-container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 2rem;
  }

  h1 {
    text-align: center;
    color: var(--primary);
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-shadow: 0 2px 10px rgba(0, 200, 150, 0.3);
  }

  .perfil-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 200, 150, 0.2);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .perfil-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  #fotoPerfil {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--primary);
    box-shadow: 0 4px 20px rgba(0, 200, 150, 0.4);
  }

  .perfil-info h2 {
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .perfil-info p {
    color: var(--primary-light);
    font-size: 1.1rem;
  }

  .btn-primary, .btn-secondary {
    padding: 0.8rem 2rem;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 200, 150, 0.4);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .form-edicion {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(147, 51, 234, 0.3);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .hidden {
    display: none;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: var(--text-light);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .form-group input {
    width: 100%;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: var(--text-light);
    font-size: 1rem;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 200, 150, 0.3);
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .pedidos-section {
    margin-top: 3rem;
  }

  .pedidos-section h2 {
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  .pedido-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .pedido-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .pedido-header h3 {
    color: var(--text-light);
    margin: 0;
  }

  .estado {
    padding: 0.3rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .estado-pendiente { background: rgba(255, 193, 7, 0.3); color: #ffc107; }
  .estado-procesando { background: rgba(33, 150, 243, 0.3); color: #2196f3; }
  .estado-enviado { background: rgba(156, 39, 176, 0.3); color: #9c27b0; }
  .estado-entregado { background: rgba(76, 175, 80, 0.3); color: #4caf50; }
  .estado-cancelado { background: rgba(244, 67, 54, 0.3); color: #f44336; }

  .pedido-fecha {
    color: var(--primary-light);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .pedido-productos {
    color: var(--text-light);
    margin-bottom: 1rem;
  }

  .pedido-total {
    color: var(--primary);
    font-size: 1.2rem;
  }

  .no-pedidos {
    text-align: center;
    color: var(--text-light);
    opacity: 0.7;
    padding: 2rem;
  }
</style>
